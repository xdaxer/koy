<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Koy</Company>
    <Product>Koy</Product>
    <Version>0.1.1</Version> <!-- x-release-please-version -->
    <PlatformTarget>x64</PlatformTarget>
    <Authors>Burhan Şahin</Authors>
    <Copyright>Copyright (c) 2026 Burhan Şahin</Copyright>
    <Description>Lightweight spring-animated notch and smart desktop dock for Windows 11</Description>
    <RepositoryUrl>https://github.com/brhnshn/koy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Tekrarlanabilir derleme: PDB ve assembly içine yerel dizin yolu (C:\Users\...) gömülmesin. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- SourceLink eşlemesindeki yerel kök dizin de /_/ olarak yazılsın (yerel derlemede de). -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
